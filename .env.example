# API Keys
# Open-Meteo is used for weather data (no API key required)
GEMINI_API_KEY=your_gemini_api_key_here  # Required for decision agent

# Weather Service Config
USE_MOCK_WEATHER=false  # Set to false to use real weather APIs
USE_CACHE=false  # Set to false to always get fresh data

# API Settings
VITE_API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO